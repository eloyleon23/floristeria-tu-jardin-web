# Copiar a .env.local para desarrollo. Ningún valor de este archivo es secreto:
# las variables NEXT_PUBLIC_* acaban en el navegador.

# Subdirectorio de publicación. Vacío en el dominio final.
# GitHub Pages: /floristeria-tu-jardin-web
NEXT_PUBLIC_BASE_PATH=

# URL pública del sitio (canonical, sitemap). Sin barra final.
NEXT_PUBLIC_SITE_URL=https://floristeriatujardin.es

# Entorno: development | preview | production. Fuera de "production" la web lleva noindex.
NEXT_PUBLIC_SITE_ENV=development
